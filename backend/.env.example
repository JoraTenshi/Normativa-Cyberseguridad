# MongoDB connection
MONGODB_URI=mongodb://localhost:27017/cybersec_audit

# Server port
PORT=5000

# Allowed CORS origin (frontend URL)
CORS_ORIGIN=https://localhost

# JWT signing secret: generate once and keep it private.
# Example: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# The result has 64 hexadecimal characters (32 random bytes).
JWT_SECRET=

# Dedicated key for 2FA secrets stored in MongoDB; do not reuse JWT_SECRET.
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep a secure backup: losing this key makes existing 2FA secrets unreadable.
TOTP_ENCRYPTION_KEY=

# Public HTTPS URL used to build links in emails (verification and password reset).
# This must reach the frontend through Nginx.
APP_URL=https://localhost
EMAIL_VERIFICATION_TTL_HOURS=24

# SMTP / email. Without these values the backend does not send mail or log
# verification and recovery links. Configure an SMTP test server for local tests.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@cyber-law.app
