# MongoDB connection
MONGODB_URI=mongodb://localhost:27017/cybersec_audit

# Server port
PORT=5000

# Allowed CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:3000

# JWT signing secret — change this to a long random string in production
# Example: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret

# Public base URL used to build links in emails (password reset, etc.)
# Falls back to CORS_ORIGIN if unset. Example: https://cyber-law.app
APP_URL=

# SMTP / email (password recovery). If these are left blank the backend
# does NOT send mail — it logs the reset link to the console instead, so the
# flow is fully testable without an email provider. Fill them in (Brevo,
# Resend, SendGrid, etc.) and restart the container to send real emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@cyber-law.app
